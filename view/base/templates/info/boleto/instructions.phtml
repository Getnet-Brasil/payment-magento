/**
 * @var \Getnet\PaymentMagento\Block\Sales\Info\Boleto $block
 * @var \Magento\Framework\Escaper $escaper
 * @see \Magento\Payment\Block\Info
 */
// Read raw additional information: getSpecificInformation() keys are translated labels
$title = $escaper->escapeHtml($block->getMethod()->getTitle());
$boletoLineCode = $block->getPaymentAdditionalInfo('boleto_line_code');
$boletoPdfHref = $block->getPaymentAdditionalInfo('boleto_pdf_href');
$expirationDateBoleto = $block->getPaymentAdditionalInfo('boleto_expiration_date');
$boletoOurNumber = $block->getPaymentAdditionalInfo('boleto_our_number');
$boletoDocumentNumber = $block->getPaymentAdditionalInfo('boleto_document_number');
$boletoPayerFullname = $block->getPaymentAdditionalInfo('boleto_payer_fullname');
$boletoPayerTaxDocument = $block->getPaymentAdditionalInfo('boleto_payer_tax_document');
?>
<h4><?= /* @noEscape */ $title ?></h4>
<?php if ($boletoLineCode || $boletoPdfHref): ?>
    <div class="getnet-instruction boleto">
        <?php if ($expirationDateBoleto): ?>
        <div class="instruction-information expiration">
            <div>
                <?= $escaper->escapeHtml(__('Your payment is valid until')); ?>
            </div>
            <div class="expiration-date">
                <strong>
                    <?= /* @noEscape */ $expirationDateBoleto; ?>
                </strong>
            </div>
        </div>
        <?php endif;?>
        <?php if ($boletoLineCode): ?>
            <div class="instruction-information barcode">
                <div class="step-to-pay">
                    <?= $escaper->escapeHtml(__('Barcode of your Boleto is')); ?>
                </div>
                <div class="boleto-text">
                    <textarea id="qr-code-value"
                        rows="3" cols="30" readonly><?= $escaper->escapeHtml($boletoLineCode) ?></textarea>
                </div>
            </div>
        <?php endif;?>
        <?php if ($boletoPdfHref): ?>
            <div class="instruction-information link">
                <div class="step-to-pay">
                    <?= $escaper->escapeHtml(__('Link to Pay')); ?>
                </div>
                <div class="boleto-link">
                    <a target="_blank"
                        href="<?=  $escaper->escapeHtml($boletoPdfHref) ?>" 
                        alt="<?= /* @noEscape */ $title ?>"><?= $escaper->escapeHtml(__('Download the Boleto')); ?></a>
                </div>
            </div>
        <?php endif;?>
        <?php if ($boletoOurNumber): ?>
            <div class="instruction-information boleto-more-information">
                <div class="label">
                    <?= $escaper->escapeHtml(__('Nosso Número')); ?>
                </div>
                <div class="value">
                    <?=  $escaper->escapeHtml($boletoOurNumber) ?>
                </div>
            </div>
        <?php endif;?>
        <?php if ($boletoDocumentNumber): ?>
            <div class="instruction-information boleto-more-information">
                <div class="label">
                    <?= $escaper->escapeHtml(__('Document Number')); ?>
                </div>
                <div class="value">
                    <?=  $escaper->escapeHtml($boletoDocumentNumber) ?>
                </div>
            </div>
        <?php endif;?>
        <?php if ($boletoPayerFullname): ?>
            <div class="instruction-information boleto-more-information">
                <div class="label">
                    <?= $escaper->escapeHtml(__('Issued on behalf of')); ?>
                </div>
                <div class="value">
                    <?=  $escaper->escapeHtml($boletoPayerFullname) ?>
                </div>
            </div>
        <?php endif;?>
        <?php if ($boletoPayerTaxDocument): ?>
            <div class="instruction-information boleto-more-information">
                <div class="label">
                    <?= $escaper->escapeHtml(__('Taxvat')); ?>
                </div>
                <div class="value">
                    <?=  $escaper->escapeHtml($boletoPayerTaxDocument) ?>
                </div>
            </div>
        <?php endif;?>
    </div>
<?php endif;?>
