/**
 * @var \Getnet\PaymentMagento\Block\Sales\Info\Pix $block
 * @var \Magento\Framework\Escaper $escaper
 * @see \Magento\Payment\Block\Info
 */
// Read raw additional information: getSpecificInformation() keys are translated labels
$title = $escaper->escapeHtml($block->getMethod()->getTitle());
$qrCode = $block->getPaymentAdditionalInfo('qr_code');
$qrCodeImage = $block->getPaymentAdditionalInfo('qr_code_image');
$qrCodeImageUrl = $qrCodeImage ? $block->getImageQrCode($qrCodeImage) : null;
$expirationDateQrcode = $block->getPaymentAdditionalInfo('expiration_date_qrcode');
?>
<h4><?= /* @noEscape */ $title ?></h4>
<?php if ($qrCode || $qrCodeImageUrl): ?>
    <div class="getnet-instruction pix">
        <?php if ($expirationDateQrcode): ?>
        <div class="instruction-information expiration">
            <div>
                <?= $escaper->escapeHtml(__('Your payment is valid until')); ?>
            </div>
            <div class="expiration-date">
                <strong>
                    <?= /* @noEscape */ $block->formatDate($expirationDateQrcode, \IntlDateFormatter::MEDIUM, true) ?>
                </strong>
            </div>
        </div>
        <?php endif;?>
        <?php if ($qrCodeImageUrl): ?>
            <div class="instruction-information qr-code-image">
                <div class="step-to-pay">
                    <?= $escaper->escapeHtml(__('To pay, read the QRCode')); ?>
                </div>
                <div class="qrcode-image">
                    <img src="<?=  $escaper->escapeHtml($qrCodeImageUrl) ?>" alt="<?= /* @noEscape */ $title ?>" />
                </div>
            </div>
        <?php endif;?>
        <?php if ($qrCode): ?>
            <div class="instruction-information qr-code">
                <div class="step-to-pay">
                    <?= $escaper->escapeHtml(__('Or if you prefer, copy and paste the code')); ?>
                </div>
                <div class="qrcode-text">
                    <textarea id="qr-code-value"
                        rows="10" cols="30" readonly><?= $escaper->escapeHtml($qrCode) ?></textarea>
                </div>
            </div>
        <?php endif;?>
    </div>
<?php endif;?>
