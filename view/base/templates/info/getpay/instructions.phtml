/**
 * @var \Getnet\PaymentMagento\Block\Sales\Info\Getpay $block
 * @var \Magento\Framework\Escaper $escaper
 * @see \Magento\Payment\Block\Info
 */
// Read raw additional information: getSpecificInformation() keys are translated labels
$title = $escaper->escapeHtml($block->getMethod()->getTitle());
$getpayLink = $block->getPaymentAdditionalInfo('getpay_link');
$getpayLexpirationDate = $block->getPaymentAdditionalInfo('getpay_expiration_date');
?>
<h4><?= /* @noEscape */ $title ?></h4>
<?php if ($getpayLink || $getpayLexpirationDate): ?>
    <div class="getnet-instruction boleto">
        <?php if ($getpayLexpirationDate): ?>
        <div class="instruction-information expiration">
            <div>
                <?= $escaper->escapeHtml(__('Your payment is valid until')); ?>
            </div>
            <div class="expiration-date">
                <strong>
                    <?= /* @noEscape */ $block->formatDate($getpayLexpirationDate, \IntlDateFormatter::MEDIUM, true) ?>
                </strong>
            </div>
        </div>
        <?php endif;?>
        <?php if ($getpayLink): ?>
            <div class="instruction-information link">
                <div class="step-to-pay">
                    <?= $escaper->escapeHtml(__('Link to Pay')); ?>
                </div>
                <div class="boleto-link">
                    <a target="_blank"
                        href="<?=  $escaper->escapeHtml($getpayLink) ?>" 
                        alt="<?= /* @noEscape */ $title ?>"><?= $escaper->escapeHtml(__('Pay Here')); ?></a>
                </div>
            </div>
        <?php endif;?>
    </div>
<?php endif;?>
